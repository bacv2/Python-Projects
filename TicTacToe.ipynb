    "class TicTacToe:\n",
    "    def __init__(self):\n",
    "        self.board = []\n",
    "    \n",
    "    def createBoard(self, height=3, width=3):\n",
    "        for num in range(width):\n",
    "            self.board.append(list('.'*height))\n",
    "        return self.board\n",
    "\n",
    "    def printBoard(self):\n",
    "        #source: GeeksforGeeks\n",
    "        for items in self.board:\n",
    "            for i in items:\n",
    "                print(i, end='  ')\n",
    "            print()\n",
    "        print()\n",
    "        return self.board\n",
    "\n",
    "    def placePiece(self, row, column, piece):\n",
    "        self.board[row][column] = piece\n",
    "        self.printBoard()\n",
    "    \n",
    "game = TicTacToe()\n",
    "game.createBoard()\n",
    "game.printBoard()\n",
    "\n",
    "END = 'END'\n",
    "playerInput = \"\"\n",
    "\n",
    "while playerInput != END:\n",
    "    playerInput = input('Enter \"row, col, piece\" or \"END\":')\n",
    "    if playerInput == END:\n",
    "        break\n",
    "    try:\n",
    "        #source: GeeksforGeeks\n",
    "        row, column, piece = playerInput.split(',')\n",
    "        game.placePiece(int(row), int(column), str(piece))       \n",
    "    except (ValueError, IndexError):\n",
    "        print(\"Invalid input or coordinates. Please use format row, column, piece.\")\n"
   ]
